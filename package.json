{
  "name": "xinwei-desktop",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/version.mjs check && vue-tsc --noEmit && vite build",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:dev:mac": "tauri dev --target aarch64-apple-darwin",
    "desktop:build:mac": "PATH=/usr/bin:/bin:/usr/sbin:/sbin:$PATH tauri build --target aarch64-apple-darwin",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
