{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "薪慰",
  "version": "1.0.0",
  "identifier": "io.xinwei.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "薪慰",
        "url": "index.html",
        "width": 280,
        "height": 180,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "backgroundColor": "#FFFFFF"
      },
      {
        "label": "settings",
        "title": "薪慰 · 设置",
        "url": "index.html?view=settings",
        "width": 620,
        "height": 740,
        "minWidth": 540,
        "minHeight": 540,
        "visible": false,
        "backgroundColor": "#F6F5F0"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png"
    ],
    "shortDescription": "每一秒，都算数。",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser",
        "installerHooks": "./nsis-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
