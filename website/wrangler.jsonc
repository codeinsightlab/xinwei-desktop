{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xinwei-website",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "xinwei.learnaiwithcode.com", "custom_domain": true }]
}
